{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Factory",
  "version": "0.1.0",
  "identifier": "com.sapeled3.factory",
  "build": {
    "frontendDist": "../../dist-app",
    "beforeBuildCommand": "node build.mjs",
    "beforeDevCommand": "node build.mjs --watch"
  },
  "app": {
    "macOSPrivateApi": true,
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Factory",
        "url": "index.html#queue",
        "width": 1320,
        "height": 860,
        "minWidth": 900,
        "minHeight": 560,
        "visible": false,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": { "x": 16, "y": 20 }
      },
      {
        "label": "widget",
        "title": "Factory widget",
        "url": "index.html?view=widget",
        "width": 420,
        "height": 640,
        "visible": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "shadow": false,
        "visibleOnAllWorkspaces": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "category": "DeveloperTool",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.png"],
    "macOS": { "minimumSystemVersion": "13.0" }
  }
}
